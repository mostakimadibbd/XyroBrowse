{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/p/:origin/:proxyPath*",
      "destination": "/api/router?__route=proxy&origin=:origin&proxyPath=:proxyPath*"
    },
    {
      "source": "/api/p/:origin",
      "destination": "/api/router?__route=proxy&origin=:origin"
    },
    {
      "source": "/api/:route*",
      "destination": "/api/router?__route=:route*"
    },
    {
      "source": "/downloads/:file*",
      "destination": "/downloads/:file*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
