{
  "name": "xyrobrowse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:desktop": "concurrently -k \"npm run dev\" \"npm run build:electron && wait-on tcp:3000 && electron .\"",
    "build:electron": "tsx scripts/build-electron.ts",
    "build": "vite build",
    "build:desktop": "npm run build && npm run build:electron && electron-builder",
    "start": "tsx server.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "perf": "tsx scripts/perf.ts",
    "icons": "tsx scripts/make-icons.ts",
    "clean": "rm -rf dist dist-electron",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@ghostery/adblocker": "^2.20.3",
    "@ghostery/adblocker-electron": "^2.20.3",
    "@ghostery/adblocker-electron-preload": "^2.20.3",
    "@mozilla/readability": "^0.6.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "cross-fetch": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hono": "^4.13.16",
    "jsdom": "^30.1.3",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tough-cookie": "^6.0.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sharp": "^0.31.1",
    "@types/tough-cookie": "^4.0.5",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.xyrobase.xyrobrowse",
    "productName": "XyroBrowse",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
