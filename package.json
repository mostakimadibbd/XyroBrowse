{
  "name": "xyrobrowse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "electron/main.ts",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:desktop": "concurrently -k \"npm run dev\" \"wait-on tcp:3000 && electron -r tsx/cjs electron/main.ts\"",
    "build": "vite build",
    "build:desktop": "npm run build && electron-builder",
    "start": "tsx server.ts",
    "test": "tsx --test tests/*.test.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.20.3",
    "@ghostery/adblocker-electron": "^2.20.3",
    "@ghostery/adblocker-electron-preload": "^2.20.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hono": "^4.8.12",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tough-cookie": "^6.0.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tough-cookie": "^4.0.5",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  }
}
